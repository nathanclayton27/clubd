{
  "slug": "avatar",
  "title": "Avatar: The Last Airbender",
  "subtitle": "with The Legend of Korra and Seven Havens",
  "kind": "animated series",
  "popularity": 85,
  "year": "2005–2026",
  "blurb": "All 126 episodes of the three series in air order — 61 chapters of The Last Airbender, then Korra's 52 and Seven Havens' 13.",
